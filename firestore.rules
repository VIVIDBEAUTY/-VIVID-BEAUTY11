rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /appointments/{appointmentId} {
      // Allow anyone to read a specific appointment if they have the ID (unguessable)
      allow get: if true;
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow anyone to create an appointment (guest booking allowed)
      allow create: if true;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
